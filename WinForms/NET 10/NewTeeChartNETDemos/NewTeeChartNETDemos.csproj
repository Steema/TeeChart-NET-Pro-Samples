    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\Sources\TeeChart.PCL.NET6\TeeChart.WinForm\TeeChart.WinForm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="*.cs" LogicalName="SourceCode/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\aircraft-cockpit-background.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
